# GPX Route Exploration — example environment
#
# Copy to `.env.development` for local dev, or `.env` for ad-hoc overrides.
# Load with: ./dev.sh --env-file .env.development
#
# Values set in your shell environment take precedence over this file.

# --- Flask ---
FLASK_PORT=5050
FLASK_SECRET_KEY=dev-secret-change-me

# --- Storage ---
# Absolute path, or relative to the repo root. Defaults to ./data.
DATA_DIR=./data

# --- External routing/geocoding services ---
VALHALLA_URL=http://10.0.1.25:8002
NOMINATIM_URL=http://10.0.1.25:8001

# --- Auth ---
# Header the reverse proxy uses to forward the authenticated username.
AUTH_USER_HEADER=Remote-User

# --- Backups ---
# Disable the periodic backup thread for local dev.
BACKUP_ENABLED=false
BACKUP_INTERVAL_HOURS=1
BACKUP_DAILY_KEEP=7
BACKUP_WEEKLY_KEEP=6
BACKUP_MONTHLY_KEEP=13
